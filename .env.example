# Copy this file to .env and fill in your key. .env is gitignored — never commit it.

# Anthropic API key — used server-side only, never shipped to the browser.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model for the bounded, single-turn classification task.
# A small/fast model is intentional (PRD §6.1: latency budget <1.5s, not a frontier model per check-in).
LLM_MODEL=claude-haiku-4-5-20251001

# Server port
PORT=3000

# Set MOCK_LLM=1 to run the UI end-to-end with deterministic stub classifications
# (no API key, no network). Useful for demos and CI. Default 0 = use the real API.
MOCK_LLM=0
